# Template za environment varijable
# Kopiraj ovaj fajl kao .env i popuni stvarne vrednosti

# Database (SQLite za development)
DATABASE_URL=sqlite:///./matematika_app.db

# Email SMTP konfiguracija (Gmail) 
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=lazar.davidovic98@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Notifikacija email
NOTIFICATION_EMAIL=lazar.davidovic98@gmail.com

# App konfiguracija
APP_NAME=Matematika App
DEBUG=True
SECRET_KEY=matematika-app-secret-key-change-in-production

# CORS origins (za development)
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]
